{
  "name": "acolyte-cloud",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build:contract": "pnpm --filter @acolyte/cloud-contract build",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup.ts",
    "migrate": "tsx scripts/migrate.ts",
    "sign-token": "tsx scripts/sign-token.ts",
    "test": "vitest run",
    "verify": "pnpm build:contract && pnpm typecheck && pnpm test",
    "deploy:preview": "pnpm verify && pnpm exec vercel build && pnpm exec vercel deploy --prebuilt --yes",
    "check:contract": "bash scripts/check-contract-released.sh",
    "release:contract": "tsx scripts/release-contract.ts"
  },
  "dependencies": {
    "@acolyte/cloud-contract": "workspace:*",
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.11.11",
    "@neondatabase/serverless": "^0.10.4",
    "hono": "^4.12.32",
    "jose": "^6.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vercel": "57.0.0",
    "vitest": "^4.1.3"
  }
}
